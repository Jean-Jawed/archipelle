{
  "hide_dotfiles": true,
  "dir_names": [
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "__pycache__",
    ".venv",
    "$RECYCLE.BIN",
    "RECYCLER",
    "System Volume Information",
    ".Trash",
    ".Trashes",
    ".Spotlight-V100",
    ".fseventsd",
    ".DocumentRevisions-V100",
    ".TemporaryItems",
    "lost+found",
    ".dropbox.cache",
    "venv",
    "env",
    "dist",
    "build",
    "target",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".next",
    ".nuxt",
    "vendor",
    ".gradle",
    ".idea",
    ".vscode"
  ],
  "file_patterns": [
    "~$*",
    ".~lock.*#",
    "*.tmp",
    "*.temp",
    "*.crdownload",
    "*.part",
    ".DS_Store",
    "._*",
    "Thumbs.db",
    "ehthumbs.db",
    "desktop.ini",
    "Icon\r"
  ]
}
